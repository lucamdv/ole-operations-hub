# Browser-safe Supabase config
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Server-only Supabase config
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Public application URL (use your production Vercel/custom domain)
PUBLIC_APP_URL=https://your-domain.example.com

# Direct MOTOR OLÉ / Excelsior integration (server-only)
EXCELSIOR_API_USERNAME=
EXCELSIOR_API_PASSWORD=
EXCELSIOR_SERVICES_BASE_URL=
EXCELSIOR_SYSTEM_ID=
EXCELSIOR_REQUEST_TIMEOUT_MS=30000
EXCELSIOR_BILLING_REQUEST_TIMEOUT_MS=120000
EXCELSIOR_POLICY_CONCURRENCY=2
EXCELSIOR_DOCUMENT_CONCURRENCY=4
EXCELSIOR_BILLING_CONCURRENCY=4

# n8n integration URLs
N8N_AUDIT_WEBHOOK_URL=
N8N_ENDORSEMENT_WEBHOOK_URL=
N8N_CORRECTION_WEBHOOK_URL=

# Callback / scheduler shared secrets
CRON_SECRET=
AUDIT_CALLBACK_SECRET=
POLICY_SYNC_HOOK_SECRET=
SCHEDULER_HOOK_SECRET=
ENDORSEMENT_CALLBACK_SECRET=
BILLING_CALLBACK_SECRET=
BILLING_RETRY_HOOK_SECRET=
